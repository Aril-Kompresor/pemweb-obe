  "item": [
    {
      "name": "1. Utilitas & CSRF Token",
      "item": [
        {
          "name": "Cek Kesehatan API (Health Check)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/health.php",
              "host": ["{{base_url}}"],
              "path": ["api", "health.php"]
            }
          },
          "response": []
        },
        {
          "name": "Dapatkan CSRF Token Baru",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code adalah 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.csrf_token) {",
                  "    pm.collectionVariables.set(\"csrf_token\", jsonData.csrf_token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/csrf.php",
              "host": ["{{base_url}}"],
              "path": ["api", "csrf.php"]
            }
          },
          "response": []
        }
      ]
    },
