# Konfigurasi Aplikasi UMKM Pesisir
APP_NAME="Sistem Informasi UMKM Pesisir"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/pemweb-obe
APP_TIMEZONE=Asia/Makassar

# Konfigurasi Database MySQL
