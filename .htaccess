Options +FollowSymLinks
DirectorySlash On

<IfModule mod_rewrite.c>
RewriteEngine On

# Redirect /dashboard dan /login tanpa trailing slash ke dengan trailing slash
# Menggunakan %{REQUEST_URI} agar aman di root (/) maupun subfolder (/pemweb-obe/)
RewriteRule ^dashboard$ %{REQUEST_URI}/ [R=301,L]
RewriteRule ^login$ %{REQUEST_URI}/ [R=301,L]
</IfModule>




